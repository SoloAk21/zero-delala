datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  BUYER
  OWNER
  AGENT
  ADMIN
}

enum ListingType {
  FOR_SALE
  FOR_RENT
  LOOKING_TO_BUY
  LOOKING_TO_RENT
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SOLD
  RENTED
  DEACTIVATED
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum RewardType {
  FREE_LISTING
  PROMOTION_COUPON
  REFERRAL_BONUS
}

model User {
  id                  String       @id @default(uuid())
  telegramId          BigInt       @unique
  username            String?
  firstName           String
  lastName            String?
  phoneNumber         String?      @unique
  isVerifiedAgent     Boolean      @default(false)
  role                UserRole     @default(BUYER)
  referralCode        String       @unique @default(uuid())
  referredById        String?
  rewardListingsCount Int          @default(0)
  referralCount       Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  referredBy          User?        @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrees           User[]       @relation("UserReferrals")
  referralsSent       Referral[]   @relation("ReferrerRel")
  referralsReceived   Referral[]   @relation("RefereeRel")
  properties          Property[]
  favorites           Favorite[]
  coupons             UserCoupon[]
  rewardLogs          RewardLog[]

  @@map("users")
}

model Location {
  id          String   @id @default(uuid())
  region      String
  subcity     String?
  woreda      String?
  kebele      String?
  latitude    Float?
  longitude   Float?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  propertyId  String   @unique
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("locations")
}

model Property {
  id            String           @id @default(uuid())
  title         String
  titleAmharic  String?
  description   String
  listingType   ListingType
  category      PropertyCategory
  status        PropertyStatus   @default(ACTIVE)
  price         Float
  isNegotiable  Boolean          @default(true)
  areaSqm       Float
  bedrooms      Int?             @default(0)
  bathrooms     Int?             @default(0)
  images        String[]         @default([])
  amenities     String[]         @default([])
  featured      Boolean          @default(false)
  viewsCount    Int              @default(0)
  
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  location      Location?
  favorites     Favorite[]
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("properties")
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  propertyId  String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favorites")
}

model ChannelGate {
  id                 String   @id @default(uuid())
  channelId          String   @unique
  channelUsername    String   @unique
  channelTitle       String
  isRequired         Boolean  @default(true)
  rewardFreeListings Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("channel_gates")
}

model Referral {
  id           String         @id @default(uuid())
  referrerId   String
  refereeId    String         @unique
  referralCode String
  status       ReferralStatus @default(PENDING)
  ipAddress    String?
  deviceHash   String?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  referrer     User           @relation("ReferrerRel", fields: [referrerId], references: [id], onDelete: Cascade)
  referee      User           @relation("RefereeRel", fields: [refereeId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

model Coupon {
  id                 String       @id @default(uuid())
  code               String       @unique
  description        String
  discountPercent    Int
  maxDiscountAmount  Float?
  isWelcomeCoupon    Boolean      @default(false)
  isReferralCoupon   Boolean      @default(false)
  maxRedemptions     Int          @default(1000)
  currentRedemptions Int          @default(0)
  expiresAt          DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  userCoupons        UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id        String    @id @default(uuid())
  userId    String
  couponId  String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@map("user_coupons")
}

model RewardLog {
  id          String     @id @default(uuid())
  userId      String
  action      String
  rewardType  RewardType
  amount      Float      @default(1)
  description String
  ipAddress   String?
  createdAt   DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reward_logs")
}